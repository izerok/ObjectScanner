            "value": "30 cm – 1 m"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 cm – 1 m"
          }
        }
      }
    },
    "3B baskı. Sadece geometri, materyal taşımaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3D printing. Geometry only, no materials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 打印。仅几何形状，不带材质。"
          }
        }
      }
    },
    "5 cm'den küçük": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "smaller than 5 cm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小于 5 厘米"
          }
        }
      }
    },
    "5 cm'in altındaki objeler her iki sensörün de çözünürlük sınırına girer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Objects under 5 cm hit the resolution limit of both sensors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小于 5 厘米的物体正好卡在两个传感器的分辨率极限上。"
          }
        }
      }
    },
    "5 – 30 cm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 – 30 cm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 – 30 cm"
          }
        }
      }
    },
    "60 cm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60 cm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "60 cm"
          }
        }
      }
    },
    "Algılama başlamadı. Cihazı objeye doğrultup tekrar deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection did not start. Point the device at the object and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测没有启动。把设备对准物体再试一次。"
          }
        }
      }
    },
    "Algılamayı Başlat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Detection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始检测"
          }
        }
      }
    },
    "Alt yüz eksik kalacak": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The underside will be missing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底面会缺失"
          }
        }
      }
    },
    "Alt yüzü de istiyorsanız objeyi çevirip devam edin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you want the underside too, flip the object and continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果底面也要，把物体翻过来继续。"
          }
        }
      }
    },
    "Anladım, Başla": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got It, Start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了，开始"
          }
        }
      }
    },
    "Apple ekosistemi, AR Quick Look. Kaynak format — dönüşüm yok.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ecosystem, AR Quick Look. The source format — no conversion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果生态、AR 快速查看。源格式，无需转换。"
          }
        }
      }
    },
    "Arka ana kamera bulunamadı. Tarama yapılamaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rear main camera found. Scanning is not possible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到后置主相机，无法扫描。"
          }
        }
      }
    },
    "Arka kamera bulunamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rear camera found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到后置相机。"
          }
        }
      }
    },
    "Arka kamera envanteri": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rear camera inventory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后置相机清单"
          }
        }
      }
    },
    "Arka kamera • obje döner • telefon sabit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rear camera • object rotates • phone stays put"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后置相机 • 物体旋转 • 手机固定"
          }
        }
      }
    },
    "Arka kamera • sen dönersin • rehberli akış": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rear camera • you orbit • guided flow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后置相机 • 你绕着走 • 引导流程"
          }
        }
      }
    },
    "Arka kameranın gördüğü ortamda doku yok — poz buradan geliyor, dokulu bir yöne dönün": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No texture in what the rear camera sees — the pose comes from there, so turn toward something textured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后置相机看到的环境没有纹理——位姿是从那里算的，转到有纹理的方向"
          }
        }
      }
    },
    "Arşiv yazılamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write the archive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩包写入失败。"
          }
        }
      }
    },
    "Ayna ve büyük camlara dikkat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch out for mirrors and large glass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小心镜子和大面积玻璃"
          }
        }
      }
    },
    "Bilgi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息"
          }
        }
      }
    },
    "Bir tur doldu — telefonun yüksekliğini veya açısını değiştirip bir tur daha çek": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One full turn done — change the phone's height or angle and shoot another"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一圈拍完了——改变手机的高度或角度，再拍一圈"
          }
        }
      }
    },
    "Bir tur yetmez — yüksekliği değiştir": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One turn is not enough — change the height"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一圈不够——换个高度"
          }
        }
      }
    },
    "Biraz uzaklaşın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move back a little"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微退后一点"
          }
        }
      }
    },
    "Biraz var": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一些"
          }
        }
      }
    },
    "Biraz yaklaşın — detay belirgin artar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a little closer — detail improves noticeably"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微靠近一点——细节会明显变好"
          }
        }
      }
    },
    "Birinci turda telefonu duvarlara doğru tut. İkinci turda biraz aşağı eğ, zemini ve mobilyanın önünü gör. Tek tur yeterli kare bırakmıyor ve model yırtık çıkıyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the first loop hold the phone toward the walls. On the second, tilt it down to see the floor and the fronts of the furniture. A single loop does not leave enough frames and the model comes out torn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一圈把手机对着墙面。第二圈略微向下倾，拍到地板和家具的正面。一圈留下的帧数不够，模型会破裂。"
          }
        }
      }
    },
    "Bitir ve Kaydet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish and Save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成并保存"
          }
        }
      }
    },
    "Bitir ve Modeli Oluştur": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish and Build Model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成并生成模型"
          }
        }
      }
    },
    "Bitti": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Bol desen / doku": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich pattern / texture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图案/纹理丰富"
          }
        }
      }
    },
    "Boyut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
