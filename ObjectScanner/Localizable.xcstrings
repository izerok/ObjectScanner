          }
        }
      }
    },
    "Yeterli kare yok — en az 25 kare gerekir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough frames — at least 25 are required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli kare yok — en az 25 kare gerekir."
          }
