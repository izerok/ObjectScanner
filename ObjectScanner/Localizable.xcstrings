    "Odanın yapısını çıkarır": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures the room's structure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提取房间结构"
          }
        }
      }
    },
    "Odanın çevresini kesintisiz dolaşıp başladığın yere dön. Yarım tur kalan duvarları eksik bırakır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the room's perimeter without stopping and return to where you started. Half a loop leaves the remaining walls incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿着房间边缘不间断地走，回到出发点。只走半圈，剩下的墙会缺失。"
          }
        }
      }
    },
    "Odağı Kilitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock Focus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定对焦"
          }
        }
      }
    },
    "Ortam çok karanlık — ışık ekleyin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too dark — add light"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太暗了——增加光线"
          }
        }
      }
    },
    "Ortamda yeterli doku yok — dokulu bir zemin kullanın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough texture in the environment — use a textured surface"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境纹理不足——用有纹理的表面"
          }
        }
      }
    },
    "Otomatik Çekim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto Capture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动拍摄"
          }
        }
      }
    },
    "Otomatik çekim açık — objeyi yavaşça döndürmeye devam edin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto capture is on — keep rotating the object slowly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动拍摄已开启——继续慢慢旋转物体"
          }
        }
      }
    },
    "Otomatiği Durdur": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Auto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止自动"
          }
        }
      }
    },
    "Oturum duraklatılamadı. Bitirip modeli oluşturmayı deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not pause the session. Try finishing and building the model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话暂停失败。试试结束并生成模型。"
          }
        }
      }
    },
    "Oturum model üretmeden sona erdi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session ended without producing a model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话结束时没有生成模型。"
          }
        }
      }
    },
    "PLY başlığı okunamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the PLY header."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PLY 文件头读取失败。"
          }
        }
      }
    },
    "PLY dosyası eksik.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PLY file is incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PLY 文件不完整。"
          }
        }
      }
    },
    "PLY'yi Paylaş": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share PLY"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享 PLY"
          }
        }
      }
    },
    "Parlak / metalik": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glossy / metallic"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光滑/金属"
          }
        }
      }
    },
    "Parlak ve metalik yüzeyler her iki yöntemi de zorlar: yansıma açıyla değiştiği için eşleşme kurulamaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glossy and metallic surfaces defeat both methods: the reflection changes with angle, so no match can be established."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光滑和金属表面会让两种方法都失效：反射随角度变化，无法建立匹配。"
          }
        }
      }
    },
    "RoomPlan hiç renk üretmiyor — çıktısı tasarım gereği sadece geometri, o yüzden gri. Bu seçenek yürürken kamera kareleri de toplar ve onlardan **ikinci bir model** çıkarır: dokulu, gerçek görünümlü. Kütüphaneye iki kayıt olarak düşer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RoomPlan produces no colour at all — its output is geometry by design, which is why it looks grey. This option also collects camera frames as you walk and builds a **second model** from them: textured, true to life. Both land in the library as separate records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RoomPlan 完全不产生颜色——它的输出按设计只有几何形状，所以是灰色的。这个选项会在你走动时同时采集相机帧，并从中生成**第二个模型**：带纹理、和实物一样。两个模型都会作为单独的记录进入扫描库。"
          }
        }
      }
    },
    "RoomPlan'in sahne boyut sınırı var. Ev taramak için odaları ayrı ayrı tarayıp modelleri birlikte kullan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RoomPlan has a scene size limit. To scan a home, scan each room separately and use the models together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RoomPlan 有场景大小限制。要扫描整套房子，把每个房间分开扫，再把模型一起用。"
          }
        }
      }
    },
    "Sadece kilitli bölge birikiyor — masa ve arka plan dışarıda.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the locked region accumulates — the table and background are excluded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有锁定的区域在累积——桌面和背景在外面。"
          }
        }
      }
    },
    "Sarı çerçeveyi objenin üzerine yerleştir": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the yellow frame over the object"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把黄色框放到物体上"
          }
        }
      }
    },
    "Sensör başlatılıyor…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting the sensor…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动传感器…"
          }
        }
      }
    },
    "Sensörler hazırlanıyor…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing sensors…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备传感器…"
          }
        }
      }
    },
    "Seç": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        }
      }
    },
    "Seçimi Kaldır": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect All"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消全选"
          }
        }
      }
    },
    "Seçin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        }
      }
    },
    "Sil": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Sürükleyerek taşı, iki parmakla boyutlandır. Sadece çerçevenin içi modellenir — masa, kâğıt ve arka plan tamamen dışlanır. Telefon sabit olduğu için tek çerçeve bütün kareler için geçerli.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move it, pinch to resize. Only the inside of the frame is modelled — the table, paper and background are excluded entirely. Because the phone stays still, one frame applies to every shot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动移动，双指捏合调整大小。只有框内会被建模——桌面、纸和背景会被完全排除。手机是固定的，所以一个框适用于所有帧。"
          }
        }
      }
    },
    "Takip başlatılıyor…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting tracking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动跟踪…"
          }
        }
      }
    },
    "Takip zayıf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking is weak"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟踪较弱"
          }
        }
      }
    },
    "Tam detay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full detail"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全细节"
          }
        }
      }
    },
    "Tamam": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Tara": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描"
          }
        }
      }
    },
    "Tara sekmesinden ilk taramanızı yapın.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make your first scan from the Scan tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“扫描”标签页做你的第一次扫描。"
          }
        }
      }
    },
    "Tarama başarısız": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描失败"
          }
        }
      }
    },
    "Tarama bulunamadı": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan not found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到扫描记录"
          }
        }
      }
    },
    "Tarama hazır": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描就绪"
          }
        }
      }
    },
    "Tarama için Ayarlar > ObjectScanner üzerinden kamera erişimini açın.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable camera access in Settings > ObjectScanner to scan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在“设置 > ObjectScanner”里开启相机权限才能扫描。"
          }
        }
      }
    },
    "Taramaya Başla": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Scanning"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始扫描"
          }
        }
      }
    },
    "Taramaya Dön": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to Scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到扫描"
          }
        }
      }
    },
    "Taramayı Başlat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始扫描"
          }
        }
      }
    },
    "Taramayı iptal et": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel the scan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消这次扫描"
          }
        }
      }
    },
    "Taramayı iptal et?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel the scan?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消这次扫描？"
          }
        }
      }
    },
    "Tarih": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期"
          }
        }
      }
    },
    "Tek seferde tek oda. Ev için odaları ayrı ayrı tarayın.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One room at a time. For a home, scan each room separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次只扫一个房间。扫整套房子时，把每个房间分开扫。"
          }
        }
      }
    },
    "Tek yörünge çektiniz. Bitirdikten sonra bu taramaya geçiş eklenemez — alt yüzü istiyorsanız şimdi çevirmeniz gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You shot a single orbit. No pass can be added to this scan after finishing — if you want the underside, you have to flip it now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你只拍了一圈。结束后无法再给这次扫描补拍——想要底面，现在就得翻面。"
          }
        }
      }
    },
    "Tek yükseklikten çekilen kareler tek bir halka oluşturur ve dikey paralaks vermez; üst yüzeyler bu yüzden yumuşar. Bir turu bitirince telefonun yüksekliğini/açısını değiştirip bir tur daha çek. Alt yüz için objeyi ters çevirip tekrarla.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames from a single height form one ring and give no vertical parallax, which is why the top surfaces soften. When a turn is done, change the phone's height or angle and shoot another. For the underside, flip the object and repeat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一高度的帧只形成一个环，没有垂直视差，所以顶面会变软。一圈拍完后，改变手机的高度或角度再拍一圈。底面则把物体翻过来重复一遍。"
          }
        }
      }
    },
    "Telefonu duvara doğru tut, yavaşça süpür": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the phone toward the wall and sweep slowly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把手机对着墙，慢慢扫过"
          }
        }
      }
    },
    "Texture yerleştiriliyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapping texture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在贴纹理"
          }
        }
      }
    },
    "Tripod veya bir desteğe yasla. Çekim sırasında telefona dokunma.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a tripod or lean it against something. Do not touch the phone while shooting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用三脚架，或者靠在什么东西上。拍摄期间不要碰手机。"
          }
        }
      }
    },
    "TrueDepth sensörü": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TrueDepth sensor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TrueDepth 传感器"
          }
        }
      }
    },
    "TrueDepth sensörü bulunamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No TrueDepth sensor found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 TrueDepth 传感器。"
          }
        }
      }
    },
    "Tümünü Seç": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
