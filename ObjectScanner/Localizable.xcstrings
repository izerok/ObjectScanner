          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源图像"
          }
        }
      }
    },
    "Kaynak görüntüler saklanır; tam detay için kütüphaneden Mac'e aktarabilirsiniz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source images are kept; you can send them to a Mac from the library for full detail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源图像会被保留；你可以从扫描库把它们发到 Mac 做全细节重建。"
          }
        }
      }
    },
    "Kaynak görüntüler silinmiş. Tam detay için objeyi yeniden taramanız gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source images were deleted. You will need to rescan the object for full detail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源图像已删除。要全细节版本，需要重新扫描物体。"
          }
        }
      }
    },
    "Kilitlenemedi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定失败"
          }
        }
      }
    },
    "Kilitleniyor…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在锁定…"
          }
        }
      }
    },
    "Konum takibi kaybedildi. Daha dokulu bir zemin ve sabit ışık deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position tracking was lost. Try a more textured surface and steady light."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置跟踪丢失。试试纹理更丰富的地面和稳定的光线。"
          }
        }
      }
    },
    "Konum takibi yok — cihazı hareket ettirin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No position tracking — move the device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有位置跟踪——移动一下设备"
          }
        }
      }
    },
    "Konum takibi yok — cihazı hareket ettirip yeniden deneyin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No position tracking — move the device and try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有位置跟踪——移动设备后重试"
          }
        }
      }
    },
    "Konum takibi zayıf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position tracking is weak"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置跟踪较弱"
          }
        }
      }
    },
    "Konum yeniden bulunuyor — bu sırada veri toplanmıyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relocalising — no data is being collected meanwhile"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新定位——期间不会采集数据"
          }
        }
      }
    },
    "Konum yeniden bulunuyor — yavaş hareket edin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relocalising — move slowly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新定位——慢点移动"
          }
        }
      }
    },
    "Kullanılamıyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用"
          }
        }
      }
    },
    "Kutuyu Sıfırla": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Box"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置框选"
          }
        }
      }
    },
    "Kütüphane": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描库"
          }
        }
      }
    },
    "Kütüphaneden PLY olarak paylaşabilirsiniz. Mesh'e çevirme henüz eklenmedi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can share it as PLY from the library. Mesh conversion is not implemented yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以从扫描库以 PLY 格式分享。转成网格的功能还没加上。"
          }
        }
      }
    },
    "LiDAR derinlik cihazı": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR depth device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR 深度相机"
          }
        }
      }
    },
    "LiDAR duvarları, kapıları, pencereleri ve mobilyayı ayrı ayrı tanır ve gerçek ölçülerle yerleştirir. Boyalı düz duvar fotogrametriyi çökertir; bu mod tam o yüzeylerde çalışır çünkü geometriyi desenden değil ölçümden alır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR recognises walls, doors, windows and furniture separately and places them at real dimensions. A flat painted wall defeats photogrammetry; this mode works on exactly those surfaces because it takes geometry from measurement, not from pattern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR 分别识别墙、门、窗和家具，并按真实尺寸放置。平整的粉刷墙会让摄影测量失效；这个模式正好在那种表面上工作，因为它从测量而不是图案获取几何形状。"
          }
        }
      }
    },
    "LiDAR menzili yaklaşık 5 metre. Duvara yapışırsan yüzeyin tamamını göremez, çok uzaklaşırsan ölçüm zayıflar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR reaches about 5 metres. Hug the wall and it cannot see the whole surface; go too far and the measurement weakens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR 量程约 5 米。贴墙太近它看不到整个表面，离太远测量会变弱。"
          }
        }
      }
    },
    "LiDAR • odayı dolaş • duvar, kapı, mobilya": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR • walk the room • walls, doors, furniture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR • 绕房间走 • 墙、门、家具"
          }
        }
      }
    },
    "LiDAR'ın gerçekten ölçtüğü yüzey üçgen ağı olarak çıkar. Girinti, çıkıntı ve dağınıklık korunur; dosya daha büyük ve geometri düzensiz olur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The surface LiDAR actually measured, as a triangle mesh. Recesses, protrusions and clutter are preserved; the file is larger and the geometry irregular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 LiDAR 真正测到的表面以三角网格输出。凹凸和杂物都会保留；文件更大，几何形状不规整。"
          }
        }
      }
    },
    "Mac tarafında ne yapmalı?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What to do on the Mac?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上要做什么？"
          }
        }
      }
    },
    "Maskeli işleme başarısız oldu, maskesiz tekrar denendi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked processing failed; retried without the mask."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带遮罩处理失败，已不用遮罩重试。"
          }
        }
      }
    },
    "Mat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matte"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哑光"
          }
        }
      }
    },
    "Mat ve dokulu yüzey fotogrametrinin en iyi çalıştığı durum. Bu objede geometri detayı TrueDepth'ten belirgin şekilde yüksek olur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A matte, textured surface is where photogrammetry works best. On this object the geometric detail will be clearly higher than TrueDepth's."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哑光且有纹理的表面是摄影测量表现最好的情况。这个物体的几何细节会明显高于 TrueDepth。"
          }
        }
      }
    },
    "Mesh çıkarılıyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extracting mesh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在提取网格"
          }
        }
      }
    },
    "Mimari": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Architectural"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建筑结构"
          }
        }
      }
    },
    "Mobilya tanınmış kutular olarak gelir — koltuğun detaylı mesh'i çıkmaz. Detaylı obje için Fotogrametri modu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Furniture arrives as recognised boxes — you will not get a detailed mesh of the sofa. Use Photogrammetry for a detailed object."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家具会以识别出的盒子形式出现——得不到沙发的精细网格。要精细物体请用摄影测量模式。"
          }
        }
      }
    },
    "Mod": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模式"
          }
        }
      }
    },
    "Model dosyası bulunamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model file not found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到模型文件。"
          }
        }
      }
    },
    "Model gerçek metre cinsinden çıkar; kütüphanede oda ölçülerini görürsünüz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model comes out in real metres; you can see the room dimensions in the library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型以真实的米为单位输出；在扫描库里可以看到房间尺寸。"
          }
        }
      }
    },
    "Model oluşturulamadı": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not build the model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型生成失败"
          }
        }
      }
    },
    "Model oluşturuluyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在生成模型"
          }
        }
      }
    },
    "Model optimize ediliyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimising model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在优化模型"
          }
        }
      }
    },
    "Modeller ve kaynak görüntüler kalıcı olarak silinir. Bu geri alınamaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models and source images are permanently deleted. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型和源图像将被永久删除，此操作不可撤销。"
          }
        }
      }
    },
    "Nokta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点"
          }
        }
      }
    },
    "Nokta bulutu / mesh, geometri odaklı araçlar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point cloud / mesh, for geometry-focused tools."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点云/网格，给以几何为主的工具用。"
          }
        }
      }
    },
    "Nokta bulutu PLY olarak kaydedildi. Mesh'e çevirme (marching cubes) sonraki artımda gelecek.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The point cloud was saved as PLY. Mesh conversion (marching cubes) comes in a later increment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点云已保存为 PLY。转网格（marching cubes）将在后续版本加入。"
          }
        }
      }
    },
    "Nokta bulutu boş — kaydedilecek veri yok.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The point cloud is empty — nothing to save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点云是空的——没有可保存的数据。"
          }
        }
      }
    },
    "Nokta bulutu boş.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The point cloud is empty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点云是空的。"
          }
        }
      }
    },
    "Nokta bulutu kaydedildi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point cloud saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点云已保存"
          }
        }
      }
    },
    "Nokta bulutu oluşturuluyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building point cloud"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在生成点云"
          }
        }
      }
    },
    "Nokta bulutu yazılıyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing point cloud"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在写入点云"
          }
        }
      }
    },
    "Obje düz ve desensiz. Fotogrametri geometriyi yüzey deseninden türetir, desen yoksa mesh yumuşayıp detay kaybolur. TrueDepth aktif IR aydınlatma yaptığı için görünümden bağımsız ölçüm alır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The object is flat and featureless. Photogrammetry derives geometry from surface pattern, and without pattern the mesh softens and detail is lost. TrueDepth uses active IR illumination, so it measures independently of appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物体平整且无特征。摄影测量从表面图案生成几何形状，没有图案，网格会变平滑、细节会丢失。TrueDepth 用主动红外照明，测量不依赖外观。"
          }
        }
      }
    },
    "Object Capture bu cihazda desteklenmiyor. LiDAR'lı bir iPhone/iPad Pro gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Object Capture is not supported on this device. A LiDAR-equipped iPhone or iPad Pro is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备不支持 Object Capture。需要带 LiDAR 的 iPhone/iPad Pro。"
          }
        }
      }
    },
    "Objenin etrafında yavaşça dönün": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit slowly around the object"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕着物体慢慢转"
          }
        }
      }
    },
    "Objeye yaklaşın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move closer to the object"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近物体"
          }
        }
      }
    },
    "Objeyi 20–100 cm mesafede tutup yavaşça tarayın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the object 20–100 cm away and scan slowly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让物体保持在 20–100 厘米距离，慢慢扫描"
          }
        }
      }
    },
    "Objeyi Kilitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock Object"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定物体"
          }
        }
      }
    },
    "Objeyi adım adım döndür": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate the object step by step"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一步步旋转物体"
          }
        }
      }
    },
    "Objeyi dokulu bir zemine koyup kadrajı sıkı tutun; çok küçük parçalar için masaüstü tarayıcı gerekir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the object on a textured surface and frame it tightly; very small parts need a desktop scanner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把物体放在有纹理的表面上，取景框紧一点；非常小的零件需要桌面扫描仪。"
          }
        }
      }
    },
    "Objeyi geçici olarak matlaştırın — talk pudrası, kuru şampuan veya mat tarama spreyi belirgin fark yaratır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily dull the object — talcum powder, dry shampoo or matte scanning spray makes a clear difference."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时让物体变哑光——爽身粉、干洗洗发水或哑光扫描喷雾效果很明显。"
          }
        }
      }
    },
    "Objeyi kadraja alın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the object into frame"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把物体放进取景框"
          }
        }
      }
    },
    "Objeyi kadrajın ortasına alıp kilitleyin: masa ve arka plan elenir, ölçüler objenin olur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Centre the object in the frame and lock it: the table and background are excluded, and the dimensions become the object's."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把物体放在取景框中央并锁定它：桌面和背景会被排除，尺寸就是物体的尺寸。"
          }
        }
      }
    },
    "Objeyi kutunun içine alın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit the object inside the box"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让物体装进框里"
          }
        }
      }
    },
    "Objeyi tanımlayın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the object"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述物体"
          }
        }
      }
    },
    "Objeyi ~10° çevirip çekin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate the object ~10° and shoot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把物体转约 10° 再拍"
          }
        }
      }
    },
    "Objeyi Çevireyim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Me Flip It"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我来翻面"
          }
        }
      }
    },
    "Oda": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Room"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间"
          }
        }
      }
    },
    "Oda modeli birkaç saniye, ardından fotoğraflı model birkaç dakika sürer. Uygulamayı arka plana almayın.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room model takes a few seconds, then the photographic model takes a few minutes. Do not send the app to the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间模型要几秒钟，之后的照片模型要几分钟。不要把应用切到后台。"
          }
        }
      }
    },
    "Oda modeli oluşturulamadı": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
